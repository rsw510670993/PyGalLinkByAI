{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "summary": {"type": "string"},
    "requires_human": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {"type": "string"},
          "target": {"type": "string"},
          "result": {"type": "string"}
        },
        "required": ["action", "target", "result"]
      }
    },
    "human_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "review_key": {"type": "string"},
          "category": {
            "type": "string",
            "enum": ["ownership", "collection", "duplicate", "cross_year", "hash_conflict", "delete", "other"]
          },
          "target": {"type": "string"},
          "question": {"type": "string"},
          "reason": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "recommended_action": {"type": "string"},
          "alternatives": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["review_key", "category", "target", "question", "reason", "evidence", "recommended_action", "alternatives"]
      }
    }
  },
  "required": ["outcome", "summary", "requires_human", "evidence", "actions", "human_review"]
}
